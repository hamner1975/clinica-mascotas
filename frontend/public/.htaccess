# Configuracion del frontend (SPA) para Apache/cPanel.
# Portable: funciona igual en la raiz o en una subcarpeta.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]
  # No interceptar la API ni el backend.
  RewriteCond %{REQUEST_URI} !/(backend|api)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
