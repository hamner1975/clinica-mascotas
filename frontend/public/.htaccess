# Configuracion del frontend (SPA) para Apache/cPanel.
# Permite que las rutas de Vue Router (history mode) funcionen al recargar.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # No interceptar la API ni el backend.
  RewriteCond %{REQUEST_URI} !^/(api|backend)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
