# ============================================================
#  Backend - Clinica Mascotas (Fase 2)
#  Copia este archivo como ".env" y ajusta los valores.
# ============================================================

APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Ruta base del API cuando NO esta en la raiz del dominio.
# Ejemplos:  (vacio en local)   /clinica/backend/public   /api
API_BASE=

# Clave para firmar los tokens JWT (cambiala por una larga y secreta)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-1234567890

# Base de datos (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=clinica_mascotas
DB_USER=clinica
DB_PASS=clinica123

# Origenes permitidos para CORS (frontend de Vite)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
